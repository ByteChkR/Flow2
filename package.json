{
  "name": "adam-flow2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11"
  },
  "workspaces": [
    "contracts",
    "packages/*",
    "apps/playground"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @adam-flow/playground",
    "dev:api": "dotnet run --project server/Flow.Api --launch-profile http",
    "check": "tsc -p tsconfig.json && npm run check --workspace @adam-flow/playground",
    "build:web": "npm run build --workspaces --if-present",
    "build": "npm run build:web && dotnet build Adam.Flow2.sln --configuration Release --no-restore",
    "test:ts": "vitest run",
    "test:dotnet": "dotnet test Adam.Flow2.sln --configuration Release --no-restore",
    "test": "npm run test:ts && npm run test:dotnet",
    "verify": "npm run check && npm run build && npm test",
    "test:browser:serve": "vite --host 127.0.0.1 --port 5174 --strictPort"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vite": "8.3.4"
  }
}
