{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adam-flow.local/schemas/v1/type.schema.json",
  "$ref": "#/$defs/type",
  "$defs": {
    "type": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/type"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/type"
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "optional"
            },
            "inner": {
              "$ref": "#/$defs/type"
            }
          },
          "required": [
            "kind",
            "inner"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "entity",
                "entityRef"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*@[1-9][0-9]*$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entityDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*@[1-9][0-9]*$"
        },
        "kind": {
          "const": "entity"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/type"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "types": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityDefinition"
          }
        }
      },
      "required": [
        "schemaVersion",
        "types"
      ],
      "additionalProperties": false
    },
    "nodeDefinition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "server",
              "browser"
            ]
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/type"
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/type"
          }
        },
        "metadata": {
          "$ref": "#/$defs/nodeMetadata"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/configField"
          }
        }
      },
      "required": [
        "type",
        "version",
        "environments",
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeDefinition"
          }
        }
      },
      "required": [
        "schemaVersion",
        "nodes"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mode": {
          "enum": [
            "backend",
            "interactive"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "typeVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "environment": {
                "enum": [
                  "server",
                  "browser"
                ]
              },
              "config": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "type",
              "typeVersion",
              "environment",
              "config"
            ],
            "additionalProperties": false
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "nodeId": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  },
                  "port": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  }
                },
                "required": [
                  "nodeId",
                  "port"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "nodeId": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  },
                  "port": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  }
                },
                "required": [
                  "nodeId",
                  "port"
                ],
                "additionalProperties": false
              },
              "codec": {
                "$ref": "#/$defs/codecReference"
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "entryNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "mode",
        "nodes",
        "connections"
      ],
      "additionalProperties": false
    },
    "codecReference": {
      "type": "object",
      "properties": {
        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "typeId",
        "version"
      ],
      "additionalProperties": false
    },
    "portMetadata": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "nodeMetadata": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/portMetadata"
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/portMetadata"
          }
        }
      },
      "additionalProperties": false
    },
    "configField": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "order": {
              "type": "integer"
            },
            "type": {
              "const": "string"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "default"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "order": {
              "type": "integer"
            },
            "type": {
              "const": "number"
            },
            "default": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "default"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "order": {
              "type": "integer"
            },
            "type": {
              "const": "boolean"
            },
            "default": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "default"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
